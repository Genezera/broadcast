# Valores do app Web exibidos em Firebase Console > Configurações do projeto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Região das Cloud Functions (functions/src/config.ts).
VITE_FUNCTIONS_REGION=southamerica-east1

# true para usar os emuladores locais (apenas em `npm run dev`).
VITE_USE_EMULATORS=false
